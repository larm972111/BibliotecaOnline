@model BibliotecaOnline.Models.Book

@{
    ViewData["Title"] = "Aggiungi Nuovo Libro";
}

<h2>Aggiungi Nuovo Libro</h2>

<form asp-action="Create" method="post">
    <div>
        <label asp-for="Title">Titolo</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Author">Autore</label>
        <input asp-for="Author" class="form-control" />
        <span asp-validation-for="Author" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="ReleaseYear">Data di Uscita</label>
        <input asp-for="ReleaseYear" min="1000" max="2099" class="form-control" />
    </div>

    <div>
        <label asp-for="Genre">Genere</label>
        <input asp-for="Genre" class="form-control" />
    </div>

    <div>
        <label asp-for="Price">Prezzo</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Salva Libro</button>
    <a asp-action="Index">Torna all'elenco</a>
</form>