@model BibliotecaOnline.Models.Book

@{
    ViewData["Title"] = "Aggiungi Nuovo Libro";
}

<h2>Aggiungi Nuovo Libro</h2>

<form asp-action="Create" method="post">
    <div>
        <label asp-for="Title">Titolo</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Author">Autore</label>
        <input asp-for="Author" class="form-control" />
        <span asp-validation-for="Author" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="ReleaseYear">Data di Uscita</label>
        <input asp-for="ReleaseYear" type="text" oninput="this.value = this.value.replace(/[^0-9]/g, '')" maxlength="4" class="form-control" />
        <span asp-validation-for="ReleaseYear" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Genre">Genere</label>
        <input asp-for="Genre" class="form-control" />
        <span asp-validation-for="Genre" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Isbn">ISBN</label>
        <input asp-for="Isbn" class="form-control" />
        <span asp-validation-for="Isbn" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="CoverUrl">URL Copertina</label>
        <input asp-for="CoverUrl" class="form-control" />
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Salva Libro</button>
    <a asp-action="Index">Torna all'elenco</a>
</form>